# copy to .env and fill in

# solana
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# ai
ANTHROPIC_API_KEY=
# Override the models used per tier. Default in code: triage=haiku-4-5, deep=opus-4-7.
# Useful in dev to keep both tiers on haiku.
SOLSHIELD_TRIAGE_MODEL=claude-haiku-4-5
SOLSHIELD_DEEP_MODEL=claude-haiku-4-5

# infra
DATABASE_URL=postgres://solshield:solshield@localhost:5432/solshield
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=solshield

# web
NEXT_PUBLIC_APP_URL=http://localhost:3000
