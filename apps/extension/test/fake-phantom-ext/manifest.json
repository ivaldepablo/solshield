{
  "manifest_version": 3,
  "name": "FakePhantom (test only)",
  "version": "1.0.0",
  "description": "Mimics real Phantom's wallet-standard registration for testing SolShield in real-world conditions.",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-loader.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
